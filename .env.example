# ---------------------------------------------------------------------------
# Mr. IndiaNZ 2027 — environment variables. NEVER commit real values.
# Set these per environment in Vercel (Development / Preview / Production).
# ---------------------------------------------------------------------------

# Canonical site URL. Production MUST be https://www.mrindianz.co.nz
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# production | staging | development (defaults from VERCEL_ENV)
APP_ENV=development

# Supabase (separate projects for staging and production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only — never expose to the browser
DATABASE_URL=                       # used by `supabase db push` / migrations only

# Email (Resend). Emails are logged as "not_configured" until both are set and the domain is verified.
RESEND_API_KEY=
EMAIL_FROM="Mr. IndiaNZ <noreply@mrindianz.co.nz>"
ADMIN_NOTIFICATION_EMAIL=

# Stripe — payments stay disabled until PAYMENTS_ENABLED=true AND all keys are present.
# Non-production environments must use test keys; production must use live keys.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MODE=test
PAYMENTS_ENABLED=false
CONTESTANT_FEE_PAYMENTS_ENABLED=false   # NZ$350 fee — keep false until fee/GST/refund terms approved

# Registration
REGISTRATION_ENABLED=false
# Non-production only: allow testing registration before policies are approved
ALLOW_UNAPPROVED_POLICIES=false

# People's Choice
VOTING_CAMPAIGN_SLUG=peoples-choice-2027
# Non-production only: use the seeded demo campaign with simulated (unpaid) demo votes
DEMO_VOTING_ENABLED=false

# Security
RATE_LIMIT_SALT=change-me-to-a-long-random-string
CRON_SECRET=change-me-to-a-long-random-string
